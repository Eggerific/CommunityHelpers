*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/
sysinfo.txt
mono_crash.*

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Burst / addressables generated
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db
